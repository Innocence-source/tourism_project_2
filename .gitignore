# ============================================================
# 全国旅游数据分析与可视化系统 —— Git 忽略规则
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib60/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ---------- 虚拟环境 ----------
# 后端 Python 虚拟环境（体积大，且可由 requirements.txt 重建）
backend/.venv/
venv/
ENV/
env/

# ---------- Django ----------
*.log
logs/
# 说明：migrations 目录必须提交，否则协作者无法建表，故不忽略
staticfiles/
media/

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 项目内临时文件 ----------
# 注意：data/ 下的 sample_data.json 与 sample_page.html 是系统演示的必要数据，
#      必须提交，不要在此忽略整个 data 目录。
*.tmp
*.bak
